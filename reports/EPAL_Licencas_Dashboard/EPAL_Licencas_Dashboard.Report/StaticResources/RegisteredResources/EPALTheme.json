{
  "name": "EPAL Água (WWTP style)",
  "dataColors": [
    "#0D6ABF",
    "#FF911B",
    "#00A9CE",
    "#003260",
    "#FFBE78",
    "#7AC143",
    "#C6E4E0",
    "#8E9BAE",
    "#E4572E",
    "#D0DBE5"
  ],
  "good": "#7AC143",
  "neutral": "#FFBE78",
  "bad": "#E4572E",
  "maximum": "#003260",
  "center": "#0D6ABF",
  "minimum": "#C6E4E0",
  "null": "#D9D9D9",
  "background": "#FFFFFF",
  "foreground": "#003260",
  "tableAccent": "#0D6ABF",
  "textClasses": {
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#003260"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#3A4A5A"
    },
    "callout": {
      "fontSize": 28,
      "fontFace": "Segoe UI Semibold",
      "color": "#0D6ABF"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#003260"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#B9C8C5"
              }
            },
            "position": "Outer",
            "preset": "BottomRight",
            "transparency": 60
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#003260"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "shape": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "preset": "BottomRight",
            "transparency": 60
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#0D6ABF"
              }
            },
            "fontSize": 26,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#3A4A5A"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#EDF4F3"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#EDF4F3"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}