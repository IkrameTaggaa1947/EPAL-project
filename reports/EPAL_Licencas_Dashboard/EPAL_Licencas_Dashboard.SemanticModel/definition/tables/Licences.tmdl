	column 'Meio Recetor (unificado)' =
			
			IF(
			    NOT ISBLANK(Licences[Meio Recetor]),
			    Licences[Meio Recetor],
			    CALCULATE(MAX(Rejeicao[Meio recetor]))
			)
		lineageTag: 69050f9d-bfee-4605-8877-10785caf05b3
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Denominação do meio recetor (unificado)' =
			
			IF(
			    NOT ISBLANK(Licences[Denominação do meio recetor]),
			    Licences[Denominação do meio recetor],
			    CALCULATE(MAX(Rejeicao[Denominação do meio recetor]))
			)
		lineageTag: 68e13a0a-8880-46a3-be35-0b3c63ef0a99
		summarizeBy: none

