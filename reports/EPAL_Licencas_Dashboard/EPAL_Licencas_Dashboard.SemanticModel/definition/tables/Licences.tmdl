	column 'Estado da Licença' =
			VAR _v = 'Licences'[Validade (ISO)]
			VAR _limite = EDATE(TODAY(), 8)
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(_v),      "Sem data",
			    _v < TODAY(),     "Caducada",
			    _v <= _limite,    "A expirar (< 8 meses)",
			                      "Válida"
			)
		dataType: string
		lineageTag: a9ff07be-e838-4932-9e84-826edf225a5b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Nome da ETAR normalizado. Liga a TabelaCentroide_ETAR (Centro Operacional, CODMAXIMO). Vazio quando o nome da licença não tem correspondência no registo de ativos.
