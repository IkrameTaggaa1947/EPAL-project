	partition Licences = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(DataFolder & "\Licenses.xlsx"), null, true),
				    Folha = Source{[Item = "Licenses", Kind = "Sheet"]}[Data],
				    Headers = Table.PromoteHeaders(Folha, [PromoteAllScalars = true]),
				    Texto = (v) => if v = null then null else Text.Trim(Text.From(v)),
				    ParaNumero = (v) => let t = Texto(v) in if t = null or t = "" then null else try Number.From(Text.Replace(t, ",", "."), "en-US") otherwise null,
				    ParaInteiro = (v) => let n = ParaNumero(v) in if n = null then null else Int64.From(Number.Round(n, 0)),
				    DatasPT = Table.TransformColumnTypes(Headers, {{"Data de Emissão", type date}, {"Data de Entrada em Vigor", type date}, {"Data de Validade", type date}}, "pt-PT"),
				    DatasISO = Table.TransformColumnTypes(DatasPT, {{"Validade (ISO)", type date}}, "en-US"),
				    Coords = Table.TransformColumns(DatasISO, {{"Longitude", ParaNumero, type number}, {"Latitude", ParaNumero, type number}}),
				    Inteiros = Table.TransformColumns(Coords, {{"Ano de arranque", ParaInteiro, Int64.Type}, {"População servida à data", ParaInteiro, Int64.Type}, {"Ano horizonte de projeto", ParaInteiro, Int64.Type}, {"População servida no horizonte", ParaInteiro, Int64.Type}}),
				    SemVazio = (v) => if v = null then "" else v,
				    Preenchidos = Table.TransformColumns(Inteiros, {{"REGIÃO", SemVazio, type text}, {"ARH", SemVazio, type text}, {"Município", SemVazio, type text}, {"Nível de tratamento", SemVazio, type text}, {"Em Vigor/Caducada", SemVazio, type text}}),
				    #"Colonnes renommées" = Table.RenameColumns(Preenchidos,{{"Nº TUA", "Nº Licence"}}),
				    OutrasOrigem = Csv.Document(File.Contents(DataFolder & "\TUA\Outras Condicoes (3.21).csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    OutrasHeaders = Table.PromoteHeaders(OutrasOrigem, [PromoteAllScalars = true]),
				    OutrasCaudal = Table.SelectRows(OutrasHeaders, each [Condição] <> null and (Text.Contains(Text.Lower([Condição]), "caudalímetro") or Text.Contains(Text.Lower([Condição]), "caudalimetro"))),
				    CaudalAgrupado = Table.Group(OutrasCaudal, {"Nº TUA"}, {{"Caudalímetro · Condição", each Text.Combine(List.Transform([Condição], each Text.Trim(_)), "#(lf)#(lf)"), type text}}),
				    JuncaoCaudal = Table.NestedJoin(#"Colonnes renommées", {"Nº Licence"}, CaudalAgrupado, {"Nº TUA"}, "caudal", JoinKind.LeftOuter),
				    ExpCaudal = Table.ExpandTableColumn(JuncaoCaudal, "caudal", {"Caudalímetro · Condição"}, {"Caudalímetro · Condição"}),
				    ComFlagCaudal = Table.AddColumn(ExpCaudal, "Caudalímetro", each if [#"Caudalímetro · Condição"] <> null and [#"Caudalímetro · Condição"] <> "" then "Sim" else "Não", type text),
				    TiposCaudal = Table.TransformColumnTypes(ComFlagCaudal, {{"Caudalímetro · Condição", type text}, {"Caudalímetro", type text}}),
				    #"Valeur remplacée" = Table.ReplaceValue(TiposCaudal,"ARH Norte","ARH do Norte",Replacer.ReplaceText,{"ARH"}),
				    #"Lignes filtrées" = Table.SelectRows(#"Valeur remplacée", each true),
				    #"Valeur remplacée1" = Table.ReplaceValue(#"Lignes filtrées","ARH Tejo e Oeste","ARH do Tejo e Oeste",Replacer.ReplaceText,{"ARH"}),
				    #"Valeur remplacée2" = Table.ReplaceValue(#"Valeur remplacée1","ARH Alentejo","ARH do Alentejo",Replacer.ReplaceText,{"ARH"}),
				    #"Lignes filtrées1" = Table.SelectRows(#"Valeur remplacée2", each true),
				    #"Valeur remplacée3" = Table.ReplaceValue(#"Lignes filtrées1","ARH Centro","ARH do Centro",Replacer.ReplaceText,{"ARH"}),
				    #"Lignes filtrées2" = Table.SelectRows(#"Valeur remplacée3", each true),
				    #"Valeur remplacée4" = Table.ReplaceValue(#"Lignes filtrées2","ARH do Centro","ARH Centro",Replacer.ReplaceText,{"ARH"}),
				    #"Valeur remplacée5" = Table.ReplaceValue(#"Valeur remplacée4","ARH do Alentejo","ARH Alentejo",Replacer.ReplaceText,{"ARH"}),
				    #"Valeur remplacée6" = Table.ReplaceValue(#"Valeur remplacée5","ARH do Tejo e Oeste","ARH Tejo e Oeste",Replacer.ReplaceText,{"ARH"}),
				    #"Valeur remplacée7" = Table.ReplaceValue(#"Valeur remplacée6","ARH do Norte"," ARH Norte",Replacer.ReplaceText,{"ARH"}),
				    #"Lignes filtrées3" = Table.SelectRows(#"Valeur remplacée7", each true)
				in
				    #"Lignes filtrées3"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

