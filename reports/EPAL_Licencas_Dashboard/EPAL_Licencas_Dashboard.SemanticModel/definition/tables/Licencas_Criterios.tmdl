table Licencas_Criterios
	lineageTag: 2f0d1985-27ba-461d-9684-4c4db5571217

	measure 'CF Média mensal' = IF(SUMX('Licencas_Criterios', RELATED('Catalogo_Criterios'[média mensal ≤ VLE])) >= 1, "#A9DFBF", "#F5B7B1")
		lineageTag: 2f0d1985-27ba-461d-9684-cf0000000000

	measure 'CF Média anual' = IF(SUMX('Licencas_Criterios', RELATED('Catalogo_Criterios'[média anual ≤ VLE])) >= 1, "#A9DFBF", "#F5B7B1")
		lineageTag: 2f0d1985-27ba-461d-9684-cf0100000000

	measure 'CF 100' = IF(SUMX('Licencas_Criterios', RELATED('Catalogo_Criterios'[≤ 100% VLE (dobro)])) >= 1, "#A9DFBF", "#F5B7B1")
		lineageTag: 2f0d1985-27ba-461d-9684-cf0200000000

	measure 'CF 150' = IF(SUMX('Licencas_Criterios', RELATED('Catalogo_Criterios'[≤ 150% VLE])) >= 1, "#A9DFBF", "#F5B7B1")
		lineageTag: 2f0d1985-27ba-461d-9684-cf0300000000

	measure 'CF Ordem' = IF(SUMX('Licencas_Criterios', RELATED('Catalogo_Criterios'[≤ uma ordem de grandeza do VLE])) >= 1, "#A9DFBF", "#F5B7B1")
		lineageTag: 2f0d1985-27ba-461d-9684-cf0400000000

	measure 'CF Gama' = IF(SUMX('Licencas_Criterios', RELATED('Catalogo_Criterios'[Gama de valores (intervalo)])) >= 1, "#A9DFBF", "#F5B7B1")
		lineageTag: 2f0d1985-27ba-461d-9684-cf0500000000

	measure 'CF Quadro III' = IF(SUMX('Licencas_Criterios', RELATED('Catalogo_Criterios'[Quadro III DL 152/97 (borlas)])) >= 1, "#A9DFBF", "#F5B7B1")
		lineageTag: 2f0d1985-27ba-461d-9684-cf0600000000

	measure 'Critérios a cumprir' =
			VAR qbr = UNICHAR(10)
			VAR pt  = UNICHAR(8226) & " "
			VAR c1 = SUMX('Licencas_Criterios', RELATED('Catalogo_Criterios'[média mensal ≤ VLE]))
			VAR c2 = SUMX('Licencas_Criterios', RELATED('Catalogo_Criterios'[média anual ≤ VLE]))
			VAR c3 = SUMX('Licencas_Criterios', RELATED('Catalogo_Criterios'[≤ 100% VLE (dobro)]))
			VAR c4 = SUMX('Licencas_Criterios', RELATED('Catalogo_Criterios'[≤ 150% VLE]))
			VAR c5 = SUMX('Licencas_Criterios', RELATED('Catalogo_Criterios'[≤ uma ordem de grandeza do VLE]))
			VAR c6 = SUMX('Licencas_Criterios', RELATED('Catalogo_Criterios'[Gama de valores (intervalo)]))
			VAR c7 = SUMX('Licencas_Criterios', RELATED('Catalogo_Criterios'[Quadro III DL 152/97 (borlas)]))
			VAR txt =
			    IF(c1 >= 1, pt & "Média mensal ≤ VLE" & qbr, "") &
			    IF(c2 >= 1, pt & "Média anual ≤ VLE" & qbr, "") &
			    IF(c3 >= 1, pt & "Máx. observado ≤ 100% VLE (dobro)" & qbr, "") &
			    IF(c4 >= 1, pt & "Máx. observado ≤ 150% VLE" & qbr, "") &
			    IF(c5 >= 1, pt & "≤ uma ordem de grandeza do VLE" & qbr, "") &
			    IF(c6 >= 1, pt & "Gama de valores (intervalo)" & qbr, "") &
			    IF(c7 >= 1, pt & "Quadro III DL 152/97 (borlas)" & qbr, "")
			RETURN
			    IF(txt = "", "—", LEFT(txt, LEN(txt) - LEN(qbr)))
		lineageTag: 2f0d1985-27ba-461d-9684-cf0700000000

	measure 'Nº Critérios Aplicáveis' = SUMX('Licencas_Criterios', RELATED('Catalogo_Criterios'[Gama de valores (intervalo)])) + SUMX('Licencas_Criterios', RELATED('Catalogo_Criterios'[≤ 100% VLE (dobro)])) + SUMX('Licencas_Criterios', RELATED('Catalogo_Criterios'[≤ 150% VLE])) + SUMX('Licencas_Criterios', RELATED('Catalogo_Criterios'[≤ uma ordem de grandeza do VLE])) + SUMX('Licencas_Criterios', RELATED('Catalogo_Criterios'[média mensal ≤ VLE])) + SUMX('Licencas_Criterios', RELATED('Catalogo_Criterios'[média anual ≤ VLE])) + SUMX('Licencas_Criterios', RELATED('Catalogo_Criterios'[Quadro III DL 152/97 (borlas)]))
		formatString: 0
		lineageTag: 2f0d1985-27ba-461d-9684-cf0800000000

	measure 'Crit Média mensal' = IF(SUMX('Licencas_Criterios', RELATED('Catalogo_Criterios'[média mensal ≤ VLE])) >= 1, "Média mensal ≤ VLE", "—")
		lineageTag: 2f0d1985-27ba-461d-9684-cf0900000000

	measure 'Crit Média anual' = IF(SUMX('Licencas_Criterios', RELATED('Catalogo_Criterios'[média anual ≤ VLE])) >= 1, "Média anual ≤ VLE", "—")
		lineageTag: 2f0d1985-27ba-461d-9684-cf0a00000000

	measure 'Crit Dobro VLE' = IF(SUMX('Licencas_Criterios', RELATED('Catalogo_Criterios'[≤ 100% VLE (dobro)])) >= 1, "Valor máx. observado ≤ dobro do VLE", "—")
		lineageTag: 2f0d1985-27ba-461d-9684-cf0b00000000

	measure 'Crit 150 VLE' = IF(SUMX('Licencas_Criterios', RELATED('Catalogo_Criterios'[≤ 150% VLE])) >= 1, "Valor máx. observado ≤ 150% do VLE", "—")
		lineageTag: 2f0d1985-27ba-461d-9684-cf0c00000000

	measure 'Crit Ordem de grandeza' = IF(SUMX('Licencas_Criterios', RELATED('Catalogo_Criterios'[≤ uma ordem de grandeza do VLE])) >= 1, "≤ uma ordem de grandeza do VLE", "—")
		lineageTag: 2f0d1985-27ba-461d-9684-cf0d00000000

	measure 'Crit Gama de valores' = IF(SUMX('Licencas_Criterios', RELATED('Catalogo_Criterios'[Gama de valores (intervalo)])) >= 1, "Dentro da gama de valores (intervalo)", "—")
		lineageTag: 2f0d1985-27ba-461d-9684-cf0e00000000

	measure 'Crit Quadro III' = IF(SUMX('Licencas_Criterios', RELATED('Catalogo_Criterios'[Quadro III DL 152/97 (borlas)])) >= 1, "Borlas — Quadro III do DL 152/97", "—")
		lineageTag: 2f0d1985-27ba-461d-9684-cf0f00000000

	measure 'Cor Crit Média mensal' = IF(SUMX('Licencas_Criterios', RELATED('Catalogo_Criterios'[média mensal ≤ VLE])) >= 1, "#1E8449", "#95A5A6")
		lineageTag: 2f0d1985-27ba-461d-9684-cc0000000000

	measure 'Cor Crit Média anual' = IF(SUMX('Licencas_Criterios', RELATED('Catalogo_Criterios'[média anual ≤ VLE])) >= 1, "#1E8449", "#95A5A6")
		lineageTag: 2f0d1985-27ba-461d-9684-cc0100000000

	measure 'Cor Crit Dobro VLE' = IF(SUMX('Licencas_Criterios', RELATED('Catalogo_Criterios'[≤ 100% VLE (dobro)])) >= 1, "#1E8449", "#95A5A6")
		lineageTag: 2f0d1985-27ba-461d-9684-cc0200000000

	measure 'Cor Crit 150 VLE' = IF(SUMX('Licencas_Criterios', RELATED('Catalogo_Criterios'[≤ 150% VLE])) >= 1, "#1E8449", "#95A5A6")
		lineageTag: 2f0d1985-27ba-461d-9684-cc0300000000

	measure 'Cor Crit Ordem de grandeza' = IF(SUMX('Licencas_Criterios', RELATED('Catalogo_Criterios'[≤ uma ordem de grandeza do VLE])) >= 1, "#1E8449", "#95A5A6")
		lineageTag: 2f0d1985-27ba-461d-9684-cc0400000000

	measure 'Cor Crit Gama de valores' = IF(SUMX('Licencas_Criterios', RELATED('Catalogo_Criterios'[Gama de valores (intervalo)])) >= 1, "#1E8449", "#95A5A6")
		lineageTag: 2f0d1985-27ba-461d-9684-cc0500000000

	measure 'Cor Crit Quadro III' = IF(SUMX('Licencas_Criterios', RELATED('Catalogo_Criterios'[Quadro III DL 152/97 (borlas)])) >= 1, "#1E8449", "#95A5A6")
		lineageTag: 2f0d1985-27ba-461d-9684-cc0600000000

	measure 'VLE do parâmetro' = SELECTEDVALUE('Licencas_Criterios'[VLE])
		lineageTag: 2f0d1985-27ba-461d-9684-cf1000000000

