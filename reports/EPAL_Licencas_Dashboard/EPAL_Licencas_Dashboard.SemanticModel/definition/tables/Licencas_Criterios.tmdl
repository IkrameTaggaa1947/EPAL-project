	/// Codigo curto normalizado do parametro. Liga a Dim_Parametro[Cod Parâmetro].
	column 'Cod Parâmetro'
		dataType: string
		lineageTag: 6e4f8b20-7003-4a00-8e00-ee0031000003
		summarizeBy: none
		sourceColumn: Cod Parâmetro

		annotation SummarizationSetBy = Automatic

	partition Licencas_Criterios = m
		mode: import
		source =
				let
				    NormPar = (v) =>
				        let t = if v = null then null else Text.Trim(Text.From(v))
				        in
				            if t = null or t = "" then null
				            else if t = "Carência Bioquímica de" then "CBO5"
				            else if t = "Carência Química de" then "CQO"
				            else t,
				    Source = Excel.Workbook(File.Contents(DataFolder & "\Licencas_Criterios.xlsx"), null, true),
				    Sheet = Source{[Item = "Licencas_Criterios", Kind = "Sheet"]}[Data],
				    Headers = Table.PromoteHeaders(Sheet, [PromoteAllScalars = true]),
				    Types = Table.TransformColumnTypes(Headers, {{"IdLicenca", type text}, {"Regime", type text}, {"Parametro", type text}, {"Unidade", type text}, {"Periodo", type text}, {"VLE", type text}, {"IdCriterio", type text}, {"Parâmetro (documento)", type text}}),
				    ComCodPar = Table.AddColumn(Types, "Cod Parâmetro", each NormPar([Parametro]), type text)
				in
				    ComCodPar

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

