	partition Conditions = m
		mode: import
		source =
				let
				    NormPar = (v) =>
				        let t = if v = null then null else Text.Trim(Text.From(v))
				        in
				            if t = null or t = "" then null
				            else if t = "Carência Bioquímica de" then "CBO5"
				            else if t = "Carência Química de" then "CQO"
				            else t,
				    Source = Excel.Workbook(File.Contents(DataFolder & "\Conditions.xlsx"), null, true),
				    Sheet = Source{[Item = "Conditions", Kind = "Sheet"]}[Data],
				    Headers = Table.PromoteHeaders(Sheet, [PromoteAllScalars = true]),
				    Types = Table.TransformColumnTypes(Headers, {{"Nº TUA", type text}, {"Parâmetro", type text}, {"Parametro", type text}, {"Unidade", type text}, {"Periodo", type text}, {"VLE", type text}, {"VLE máx", type text}, {"Legislação aplicável", type text}, {"Avaliação da Conformidade Legal", type text}, {"Frequência de amostragem", type text}, {"Tipo de amostragem", type text}, {"Diploma (Legislação)", type text}}),
				    TextoLimpo = Table.AddColumn(Types, "__txt", each if [Avaliação da Conformidade Legal] = null then null else Text.Trim([Avaliação da Conformidade Legal]), type text),
				    DicOrigem = Excel.Workbook(File.Contents(DataFolder & "\Dim_Avaliacao.xlsx"), null, true),
				    DicFolha = DicOrigem{[Item = "Dim_Avaliacao", Kind = "Sheet"]}[Data],
				    DicHeaders = Table.PromoteHeaders(DicFolha, [PromoteAllScalars = true]),
				    DicSel = Table.SelectColumns(DicHeaders, {"Cod Avaliação", "Diploma", "Avaliação (texto completo)"}),
				    DicTipos = Table.TransformColumnTypes(DicSel, {{"Cod Avaliação", type text}, {"Diploma", type text}, {"Avaliação (texto completo)", type text}}),
				    DicUnico = Table.Distinct(DicTipos, {"Avaliação (texto completo)"}),
				    Juncao = Table.NestedJoin(TextoLimpo, {"__txt"}, DicUnico, {"Avaliação (texto completo)"}, "dic", JoinKind.LeftOuter),
				    Expandido = Table.ExpandTableColumn(Juncao, "dic", {"Cod Avaliação", "Diploma"}, {"Cod Avaliação", "Diploma"}),
				    SemAux = Table.RemoveColumns(Expandido, {"__txt"}),
				    TiposFinais = Table.TransformColumnTypes(SemAux, {{"Cod Avaliação", type text}, {"Diploma", type text}}),
				    ComCodPar = Table.AddColumn(TiposFinais, "Cod Parâmetro", each NormPar([Parametro]), type text)
				in
				    ComCodPar

	annotation PBI_NavigationStepName = Navigation

