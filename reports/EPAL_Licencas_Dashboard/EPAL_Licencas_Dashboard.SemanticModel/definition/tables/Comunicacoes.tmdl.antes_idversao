	partition Comunicacoes = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(DataFolder & "\Comunicacoes.xlsx"), null, true),
				    Folha = Source{[Item = "Comunicacoes", Kind = "Sheet"]}[Data],
				    Headers = Table.PromoteHeaders(Folha, [PromoteAllScalars = true]),
				    Sel = Table.SelectColumns(Headers, {"Nº TUA", "Código", "Tipo de informação/Parâmetros", "Formato de reporte", "Periodicidade de comunicação", "Data de reporte", "Entidade"}),
				    ComTUA = Table.SelectRows(Sel, each [#"Nº TUA"] <> null and [#"Nº TUA"] <> ""),
				    SemCabecalhosRepetidos = Table.SelectRows(ComTUA, each [Código] <> "Código" and [#"Tipo de informação/Parâmetros"] <> "Tipo de informação/Parâmetros"),
				    Limpo = Table.TransformColumns(SemCabecalhosRepetidos, {
				        {"Formato de reporte", each if _ = null then null else Text.Trim(_), type text},
				        {"Periodicidade de comunicação", each if _ = null then null else Text.Trim(_), type text},
				        {"Data de reporte", each if _ = null then null else Text.Trim(_), type text},
				        {"Entidade", each if _ = null then null else Text.Trim(_), type text}}),
				    NormPeriodo = (v) =>
				        let t = if v = null then "" else Text.Lower(Text.Trim(Text.From(v)))
				        in
				            if t = "" then "Não especificada"
				            else if Text.Contains(t, "mensal") and not Text.Contains(t, "semestral") then "Mensal"
				            else if Text.Contains(t, "trimestr") then "Trimestral"
				            else if Text.Contains(t, "semestr") then "Semestral"
				            else if Text.Contains(t, "anual") then "Anual"
				            else "A verificar",
				    NormFormato = (v) =>
				        let t = if v = null then "" else Text.Lower(Text.Trim(Text.From(v)))
				        in
				            if t = "" then "Não especificado"
				            else if Text.Contains(t, "siliamb") then "Plataforma SILiAmb"
				            else if Text.Contains(t, "autocontrolo") then "Módulo de Autocontrolo"
				            else if Text.Contains(t, "periodicidade") or Text.Contains(t, "trimestral") or Text.Contains(t, "descrição") then "A verificar"
				            else if Text.Contains(t, "mail") then "E-mail"
				            else Text.Proper(Text.Trim(Text.From(v))),
				    ComPeriodo = Table.AddColumn(Limpo, "Periodicidade (normalizada)", each NormPeriodo([#"Periodicidade de comunicação"]), type text),
				    ComFormato = Table.AddColumn(ComPeriodo, "Formato (normalizado)", each NormFormato([Formato de reporte]), type text),
				    ComOrdem = Table.AddColumn(ComFormato, "Ordem Periodicidade", each
				        if [#"Periodicidade (normalizada)"] = "Mensal" then 1
				        else if [#"Periodicidade (normalizada)"] = "Trimestral" then 2
				        else if [#"Periodicidade (normalizada)"] = "Semestral" then 3
				        else if [#"Periodicidade (normalizada)"] = "Anual" then 4
				        else 9, Int64.Type),
				    Tipos = Table.TransformColumnTypes(ComOrdem, {{"Nº TUA", type text}, {"Código", type text}, {"Tipo de informação/Parâmetros", type text}, {"Formato de reporte", type text}, {"Formato (normalizado)", type text}, {"Periodicidade de comunicação", type text}, {"Periodicidade (normalizada)", type text}, {"Data de reporte", type text}, {"Entidade", type text}})
				in
				    Tipos

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

